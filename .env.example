# ==============================================================================
# RETORNO — Exemplo de Configuração de Ambiente (NUNCA incluir segredos reais)
# ==============================================================================

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3340

# Bancos MySQL isolados do projeto (nunca reutilizar bancos compartilhados)
DATABASE_URL="mysql://retorno_app:CHANGE_ME_LOCAL_DEV_PASS@127.0.0.1:33306/retorno_dev"
TEST_DATABASE_URL="mysql://retorno_test:CHANGE_ME_LOCAL_TEST_PASS@127.0.0.1:33307/retorno_test"

# CORS restrito às origens locais do frontend
CORS_ORIGIN="http://127.0.0.1:4178,http://localhost:4178"

# Sessão revogável (token opaco CSPRNG armazenado como SHA-256 no MySQL)
SESSION_COOKIE_NAME="retorno_sid"
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Seed explícito apenas para desenvolvimento local (nunca habilitar em produção)
SEED_CONFIRM_ISOLATED_DB=false

# IA — Gemini API (exclusiva do backend). Sem chave, atendimento manual continua normal.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Em desenvolvimento/testes sem chave, habilita simulação determinística explicitamente identificada
AI_ALLOW_SIMULATED_FALLBACK=false
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_MS=12000
AI_RATE_LIMIT_PER_MIN=6
AI_MAX_CONCURRENT_PER_USER=2
AI_MAX_CONCURRENT_GLOBAL=5
